{
  "name": "react-device-frameset",
  "version": "2.0.0",
  "author": "Albert Hbrls <shuaizhexu@gmail.com>",
  "description": "This is yet another device frameset component for React.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
